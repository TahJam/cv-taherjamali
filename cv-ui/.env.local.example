# Where the UI's proxies (api/chat.js, api/ops/[...path].js, api/voice-*.js,
# api/rag-search.js) forward requests. Local dev: point at
# your local cv-chat-service adapter. Production: the real deployed
# cv-chat-service Vercel Project URL. Never hardcode this.
CHAT_SERVICE_URL=http://localhost:8787

# Must match cv-chat-service/.env.local's CHAT_SERVICE_SECRET exactly.
# Injected server-side by api/chat.js and the voice proxies; never sent to the browser.
CHAT_SERVICE_SECRET=xxx

# Logging (pino). Levels: trace|debug|info|warn|error|fatal.
# Defaults to `info` in production and `debug` locally. Node contexts
# (scripts/dev-server.mjs, api/cron/evaluate.js) use real pino with
# pino-pretty locally; Edge handlers use api/_shared/logger.js, which emits
# the same JSON — pipe it through pino-pretty to read it:
#   vercel logs <deployment> | npx pino-pretty
LOG_LEVEL=debug
