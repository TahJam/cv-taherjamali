# Where the UI's api/chat.js proxy forwards requests. Local dev: point at
# your local cv-chat-service adapter. Production: the real deployed
# cv-chat-service Vercel Project URL. Never hardcode this.
CHAT_SERVICE_URL=http://localhost:8787

# Must match cv-chat-service/.env.local's CHAT_SERVICE_SECRET exactly.
CHAT_SERVICE_SECRET=xxx
