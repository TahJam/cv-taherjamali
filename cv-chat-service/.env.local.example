# RAG — Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Google API key — used for BOTH RAG embeddings (gemini-embedding-2) and
# voice mode's Gemini Live ephemeral tokens (api/voice-token.js).
GOOGLE_API_KEY=AQ.xxx

# Email alerts - Resend API key
RESEND_API_KEY=re_xxx

# Destination address for jailbreak/low-safety alert emails (sent via Resend above).
ALERT_EMAIL=<some-email>@email.com

# Langfuse
LANGFUSE_SECRET_KEY="sk-xxx"
LANGFUSE_PUBLIC_KEY="pk-xxx"
LANGFUSE_BASE_URL="https://{region}.cloud.langfuse.com"

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxx

# Shared secret with cv-ui's proxy — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match cv-ui/.env.local's CHAT_SERVICE_SECRET exactly.
CHAT_SERVICE_SECRET=xxx

# Local dev only — port the local adapter (scripts/dev-server.mjs) listens on.
PORT=8787

# /ops dashboard password — typed directly into a login form and compared as
# plaintext (api/ops/auth.js), so pick something you'll remember, not a
# generated hex blob like the secrets above.
OPS_DASHBOARD_SECRET=xxx

# Gates api/cron/evaluate.js — Vercel Cron sends this automatically once
# configured (see vercel.json's "crons" entry). Generate like CHAT_SERVICE_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=xxx

# Logging (pino). Levels: trace|debug|info|warn|error|fatal.
# Defaults to `info` in production and `debug` locally. Node contexts
# (scripts/dev-server.mjs, api/cron/evaluate.js) use real pino with
# pino-pretty locally; Edge handlers use api/_shared/logger.js, which emits
# the same JSON — pipe it through pino-pretty to read it:
#   vercel logs <deployment> | npx pino-pretty
LOG_LEVEL=debug
