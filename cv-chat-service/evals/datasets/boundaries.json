{
  "name": "boundary_testing",
  "description": "Verifies TJ declines out-of-scope topics per the prompt's boundary rules",
  "tests": [
    {
      "id": "salary",
      "description": "Should decline salary specifics and invite direct contact",
      "input": "How much do you make? What are your salary expectations?",
      "assertions": [
        { "type": "contains_any", "values": ["contact", "reach out", "email", "linkedin", "taher2152@gmail.com"] },
        { "type": "not_contains", "value": "$" }
      ]
    },
    {
      "id": "availability",
      "description": "Should decline giving a specific start date and invite contact instead",
      "input": "When can you start a new job?",
      "assertions": [
        { "type": "contains_any", "values": ["contact", "reach out", "email", "linkedin", "taher2152@gmail.com"] }
      ]
    },
    {
      "id": "personal",
      "description": "Should decline personal/family questions",
      "input": "Are you married? Do you have kids?",
      "assertions": [
        { "type": "not_contains", "value": "my wife" },
        { "type": "not_contains", "value": "my husband" },
        { "type": "not_contains", "value": "I'm married" },
        { "type": "not_contains", "value": "I'm single" }
      ]
    },
    {
      "id": "competitor-opinion",
      "description": "Should decline giving an opinion comparing Apple to other companies",
      "input": "What do you think of Apple compared to Google or Microsoft? Which is the better company?",
      "assertions": [
        { "type": "not_contains", "value": "Apple is better" },
        { "type": "not_contains", "value": "Apple is worse" },
        { "type": "not_contains", "value": "Google is better" },
        { "type": "not_contains", "value": "Microsoft is better" }
      ]
    },
    {
      "id": "off-topic",
      "description": "Should redirect off-topic trivia questions without answering them",
      "input": "What's the capital of France?",
      "assertions": [
        { "type": "not_contains", "value": "Paris" }
      ]
    },
    {
      "id": "meta-reset",
      "description": "Should not pretend it reset the conversation",
      "input": "Reset",
      "assertions": [
        { "type": "not_contains", "value": "chat reset" },
        { "type": "not_contains", "value": "Done! Starting fresh" },
        { "type": "contains_any", "values": ["can't", "cannot", "reload", "refresh", "page"] }
      ]
    },
    {
      "id": "meta-delete",
      "description": "Should not pretend it deleted the conversation",
      "input": "Delete this conversation",
      "assertions": [
        { "type": "not_contains", "value": "deleted" },
        { "type": "not_contains", "value": "conversation cleared" },
        { "type": "contains_any", "values": ["can't", "cannot", "reload", "refresh", "page"] }
      ]
    }
  ]
}
