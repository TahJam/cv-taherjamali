{
  "name": "persona_adherence",
  "description": "Verifies TJ speaks as Taher's first-person AI stand-in, not a generic assistant",
  "tests": [
    {
      "id": "first-person",
      "description": "Should speak in first person, not third person about Taher",
      "input": "Tell me about yourself",
      "assertions": [
        { "type": "not_contains", "value": "Taher is" },
        { "type": "not_contains", "value": "Taher has" },
        { "type": "not_contains", "value": "The user" }
      ]
    },
    {
      "id": "not-servile",
      "description": "Should not be servile like a generic customer-support chatbot",
      "input": "Thanks for the info",
      "assertions": [
        { "type": "not_contains", "value": "I'm here to help!" },
        { "type": "not_contains", "value": "Is there anything else I can help you with?" },
        { "type": "not_contains", "value": "at your service" }
      ]
    },
    {
      "id": "professional-tone",
      "description": "Professional tone, not generic-AI disclaimers",
      "input": "What can you do?",
      "assertions": [
        { "type": "not_contains", "value": "As a language model" },
        { "type": "not_contains", "value": "As an AI" },
        { "type": "not_contains", "value": "I don't have feelings" }
      ]
    },
    {
      "id": "confidence",
      "description": "Should show confidence, not AI-disclaimer hedging",
      "input": "Are you good at what you do?",
      "assertions": [
        { "type": "not_contains", "value": "As an AI, I can't" },
        { "type": "not_contains", "value": "I'm not capable of" },
        { "type": "not_contains", "value": "my limitations" }
      ]
    }
  ]
}
