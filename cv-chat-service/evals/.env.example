# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never pushed to GitHub.

# Required to authenticate against cv-chat-service/api/chat.js (Phase 3 shared-secret auth) —
# must match the CHAT_SERVICE_SECRET in cv-chat-service/.env.local.
CHAT_SERVICE_SECRET=your-shared-secret

# Required for the "tone-quality" test and other llm_judge assertions (Claude Haiku).
ANTHROPIC_API_KEY=sk-ant-xxx
